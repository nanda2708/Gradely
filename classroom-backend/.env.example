# MongoDB connection string
CLASSROOM_DB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Backend server port (Render supplies PORT automatically)
PORT=5000

# Comma-separated frontend origins. Use the deployed Vercel URL in production.
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK service-account credentials
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-client-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----\n"

# Cloudinary backend credentials. These are used only by the authenticated
# upload proxy; never expose API_SECRET in the frontend.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Razorpay TEST MODE credentials. Keep the secret server-side only.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_KEY_ID=rzp_test_<key-id>
RAZORPAY_KEY_SECRET=<key-secret>

# Gemini AI Helper. NEVER expose GEMINI_API_KEY in the frontend.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
